        <mxCell id="ped" value="&lt;b&gt;&lt;font color=&quot;#2c7a7b&quot;&gt;2. Contexte pédagogique&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Sujet, module, concept, niveau de l'apprenant, objectif du cours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6fffa;strokeColor=#2c7a7b;strokeWidth=2;fontSize=15;fontColor=#1a202c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=8;" vertex="1" parent="1">
