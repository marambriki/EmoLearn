        </mxCell>
        <mxCell id="rag" value="&lt;b&gt;&lt;font color=&quot;#2b6cb0&quot;&gt;1. Contexte de référence (RAG)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Passages documentaires indexés, ou contexte générique si rien de pertinent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#2b6cb0;strokeWidth=2;fontSize=15;fontColor=#1a202c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=8;" vertex="1" parent="1">
