  <diagram id="prompt-blocks" name="Architecture du prompt">
    <mxGraphModel dx="1100" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="1100" math="0" shadow="0">
      <root>
