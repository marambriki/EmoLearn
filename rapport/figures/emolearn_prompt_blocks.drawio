        <mxCell id="sys" value="&lt;b&gt;&lt;font color=&quot;#4a5568&quot;&gt;Message système&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Rôle : expert en pédagogie  ·  n'inventer aucun fait absent du contexte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#4a5568;strokeWidth=2;fontSize=15;fontColor=#1a202c;align=left;verticalAlign=middle;spacingLeft=16;arcSize=8;" vertex="1" parent="1">
